{
  "name": "minimal-mistakes",
  "private": true,
  "version": "4.24.0",
  "description": "Minimal Mistakes 2 column Jekyll theme.",
  "repository": {
    "type": "git",
    "url": "git://github.com/mmistakes/minimal-mistakes.git"
  },
  "keywords": [
    "jekyll",
    "theme",
    "minimal"
  ],
  "author": "Michael Rose",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mmistakes/minimal-mistakes/issues"
  },
  "homepage": "https://mmistakes.github.io/minimal-mistakes/",
  "engines": {
    "node": ">= 0.10.0"
  },
  "devDependencies": {
    "axe-core": "^4.11.0",
    "npm-run-all": "^4.1.5",
    "onchange": "^7.1.0",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.56.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.34.4",
    "uglify-js": "^3.13.6"
  },
  "scripts": {
    "uglify": "uglifyjs assets/js/vendor/jquery/jquery-3.5.1.js assets/js/plugins/jquery.fitvids.js assets/js/plugins/jquery.greedy-navigation.js assets/js/plugins/jquery.magnific-popup.js assets/js/plugins/jquery.ba-throttle-debounce.js assets/js/plugins/smooth-scroll.js assets/js/plugins/gumshoe.js assets/js/_main.js -c -m -o assets/js/main.min.js",
    "add-banner": "node banner.js",
    "watch:js": "onchange \"assets/js/**/*.js\" -e \"assets/js/main.min.js\" -- npm run build:js",
    "build:js": "npm run uglify && npm run add-banner",
    "debug": "scripts/debug.sh --throttle",
    "debug:mobile": "scripts/debug.sh --throttle --viewport mobile",
    "doctor": "bundle exec ruby scripts/doctor.rb",
    "diagnose": "node scripts/diagnose.mjs",
    "selftest": "node scripts/selftest.mjs",
    "serve": "scripts/serve.sh",
    "debug:fast": "scripts/debug.sh --skip-build --skip-vitals --skip-a11y",
    "baseline": "scripts/debug.sh --throttle --update-baseline",
    "known": "node scripts/diagnose.mjs --throttle --skip-visual --known debug-known-issues.json --update-known",
    "critical": "node scripts/critical-css.mjs"
  }
}
